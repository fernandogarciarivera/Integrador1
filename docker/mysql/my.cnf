[mysqld]
; MySQL 9.2 optimized for Laravel development (single-host, moderate load)

; InnoDB: primary storage engine
default_storage_engine=InnoDB

; Memory: buffer pool should be ~50% of container memory (1GB container → 512M BP)
innodb_buffer_pool_size=512M
innodb_buffer_pool_instances=4
innodb_buffer_pool_chunk_size=128M
innodb_log_file_size=256M
innodb_log_buffer_size=32M

; Disable query cache (obsolete in MySQL 8.0+; causes lock contention)
query_cache_size=0
query_cache_type=0

; Connections
max_connections=500
max_allowed_packet=64M
connect_timeout=10
read_timeout=30
write_timeout=30
wait_timeout=28800
interactive_timeout=28800

; I/O performance
innodb_flush_method=O_DIRECT
innodb_flush_log_at_trx_commit=2
innodb_write_io_threads=8
innodb_read_io_threads=8
innodb_lock_wait_timeout=50

; Disable slow query logging in development (performance tax)
; Uncomment only when profiling:
; slow_query_log=0
; slow_query_log_file=/var/log/mysql/slow.log
; long_query_time=1
; log-queries-not-using-indexes=0

; Charset defaults
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

; DNS: skip name resolution (speed up connections)
skip-name-resolve

; SQL mode compatibility for Laravel/MySQL 8
sql-mode="STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

; Replication & logs
log_bin=mysql-bin
log_error=/var/log/mysql/error.log
binlog_format=ROW
max_binlog_size=256M

; Development: no SSL requirement
ssl=0
require_secure_transport=OFF

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
